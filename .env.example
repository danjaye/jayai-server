# danauth server config — copy to `.env` and fill in. NEVER share/commit the real `.env`.
# Every value can also be set as a real environment variable, which wins over this file.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=3000
SEARCH_SECRET=
ALLOWED_ORIGIN=*

# --- danauth email auth ---
AUTH_DB_PATH=./danauth.sqlite
AUTH_PEPPER=PASTE_LONG_RANDOM_HEX_HERE
TOKEN_DAYS=30

# --- Zoho SMTP (noreply@danjaye.lol) ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=noreply@danjaye.lol
SMTP_PASS=PASTE_ZOHO_APP_PASSWORD_HERE
MAIL_FROM=danauth <noreply@danjaye.lol>

# --- dev only (NEVER in production): log email codes to console instead of sending ---
# ALLOW_NO_SMTP=1
